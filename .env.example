# Required runtime mode: development, test, or production
NODE_ENV=development
PORT=5000

# Set to a cryptographically random secret of at least 32 bytes.
# Generate a fresh value locally; never commit a populated .env file.
JWT_SECRET=<generate-a-random-secret-at-least-32-bytes>

# Configure either DATABASE_URL or all DB_* fields below.
DATABASE_URL=
DB_USER=<postgres-role>
DB_HOST=localhost
DB_NAME=ledgerly
DB_PASSWORD=<local-postgres-password>
DB_PORT=5432

# Optional comma-separated exact browser origins. Empty means same-origin only.
CORS_ORIGINS=
